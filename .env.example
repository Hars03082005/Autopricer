# ==============================================================================
# PriceRef Environment Variables — Example Template
# Copy to .env for local development. Never commit real secrets.
# ==============================================================================

# Backend Environment
APP_ENVIRONMENT=development
ACTIVE_VARIANT_ID=final
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173
LOG_LEVEL=info

# Admin Token (Server-side ONLY — min 32 chars, do not prefix with VITE_)
ALLOW_RUNTIME_VARIANT_SWITCH=false
ADMIN_API_TOKEN=your_admin_api_token_here_min_32_characters

# Model Artifact Integrity (Optional override; defaults to trusted metadata hash)
EXPECTED_BUNDLE_SHA256=5c3a2ccee8efb8d842b0bac7a6380c49d2491a39b403e10dac5a279ed4bf9f3b

# Supabase (Server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_TIMEOUT_SECONDS=15
MAX_HISTORY_ROWS=500

# Frontend (Vite build-time configuration — NO secrets here)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
