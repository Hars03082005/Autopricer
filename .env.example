# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored and excluded from Docker builds.
#
#   cp .env.example .env
#
# Nothing here is required to run valuations — the ML endpoints work with no
# configuration at all. Supabase only adds sign-in and cloud history.
# ─────────────────────────────────────────────────────────────────────────────

# ══ Shared ═══════════════════════════════════════════════════════════════════

# development | staging | production
# Anything other than development tightens validation: CORS_ALLOWED_ORIGINS
# becomes mandatory and '*' is refused outright.
APP_ENVIRONMENT=development


# ══ Backend (FastAPI container) ═══════════════════════════════════════════════

# Which model variant to serve. Only variant_1 is baked into the image, and
# startup fails fast if this names anything else.
#
# NOTE: this previously read `variant_7`, which does not exist — only variant_1
# through variant_4 are in the registry. The backend silently fell through to a
# fallback artifact path instead of failing, so the deployment served a model
# nobody had chosen.
ACTIVE_VARIANT_ID=variant_1

# Comma-separated origin allowlist. Not needed in the deployed topology, where
# the frontend's nginx proxies the API and browser traffic is same-origin — this
# is for `npm run dev` and the Flutter shell, which call the API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Admin surface. POST /api/registry/{id}/activate changes which model serves
# prices, and it writes to disk inside a single replica — so it is disabled
# unless both of these are set, and it must never be enabled in production.
ALLOW_RUNTIME_VARIANT_SWITCH=false
# Minimum 32 characters. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# uvicorn log level: critical | error | warning | info | debug | trace
LOG_LEVEL=info

# Tuning, both optional — the defaults shown are what the code uses.
# Timeout for PostgREST calls, in seconds.
SUPABASE_TIMEOUT_SECONDS=15
# Hard cap on rows returned by GET /api/history, whatever `limit` a client asks for.
MAX_HISTORY_ROWS=500


# ══ Supabase ═════════════════════════════════════════════════════════════════
# From the Supabase dashboard: Project Settings -> API.

# Used by both containers.
SUPABASE_URL=

# PUBLIC key. Safe in browser JavaScript — row-level security is what protects
# the data, not the secrecy of this key. Read by the frontend (injected into
# config.js at container start) and by the backend, which forwards the caller's
# own JWT alongside it so RLS still applies to server-side queries.
SUPABASE_ANON_KEY=

# SECRET key — bypasses row-level security completely.
#
# No current request path uses it: user-scoped queries deliberately run as the
# caller so RLS stays in force. Leave it blank unless you add an endpoint that
# genuinely needs to act outside RLS. It must NEVER be given to the frontend
# container, and never appear in a VITE_-prefixed variable, because anything
# Vite inlines is readable by every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for projects still using legacy HS256 JWT signing. Projects on
# asymmetric keys (the current default) are verified against the published JWKS
# and need nothing here. Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=


# ══ Frontend (nginx container) ═══════════════════════════════════════════════

# Where nginx proxies API requests. Include the scheme.
#   docker compose:      http://backend:8000
#   Azure Container Apps: https://<backend-app>.internal.<env-default-domain>
BACKEND_ORIGIN=http://backend:8000

# Override to make the browser call the API directly instead of through the
# proxy. Normally left empty — same-origin needs no CORS and no extra hop.
APP_API_URL=

# Identifies the built artifact in logs and error reports. CI sets it to the git SHA.
APP_RELEASE=local


# ══ Local `npm run dev` only ═════════════════════════════════════════════════
# Vite reads VITE_-prefixed variables at build/dev time. In containers these are
# superseded by the runtime config above; they exist for running Vite directly.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
